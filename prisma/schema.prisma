generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Event {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  name        String
  slug        String   @unique
  description String?
  date        DateTime
  location    String?
  active      Boolean  @default(true)
  waivers     Waiver[]
}

model Waiver {
  id                    String         @id @default(cuid())
  createdAt             DateTime       @default(now())
  firstName             String
  lastName              String
  email                 String
  phone                 String?
  dateOfBirth           String
  emergencyContactName  String
  emergencyContactPhone String
  signatureType         String         // "draw" or "type"
  signatureData         String         // base64 image or typed name
  agreedToWaiver        Boolean        @default(false)
  mailchimpOptIn        Boolean        @default(false)
  checkedIn             Boolean        @default(false)
  eventId               String?
  event                 Event?         @relation(fields: [eventId], references: [id])
  familyMembers         FamilyMember[]
}

model FamilyMember {
  id        String @id @default(cuid())
  waiverId  String
  waiver    Waiver @relation(fields: [waiverId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  age       Int
}
