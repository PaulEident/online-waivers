generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ──────────────────────────────────────────
// Enums
// ──────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ORG_OWNER
  ORG_ADMIN
  EVENT_MANAGER
  USER
}

enum OrgRole {
  OWNER
  ADMIN
  EVENT_MANAGER
}

enum SubmissionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum TimeLogStatus {
  PENDING
  APPROVED
  DISPUTED
  EXPIRED
}

enum SlotSignupStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

// ──────────────────────────────────────────
// Auth (NextAuth.js v5)
// ──────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  bio           String?   @db.Text
  role          UserRole  @default(USER)
  marketingOptIn Boolean?

  accounts       Account[]
  sessions       Session[]
  orgMembers     OrgMember[]
  eventManagers  EventManager[]
  waivers        Waiver[]
  checkIns       CheckIn[]
  checkedInBy    CheckIn[]      @relation("CheckedInBy")
  volunteerTimeLogs  VolunteerTimeLog[] @relation("VolunteerTimeLogs")
  reviewedTimeLogs   VolunteerTimeLog[] @relation("ReviewedTimeLogs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ──────────────────────────────────────────
// Multi-tenant: Organizations & Events
// ──────────────────────────────────────────

model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  waiverTemplate   String   @db.Text
  mailchimpEnabled Boolean  @default(false)

  members OrgMember[]
  events  Event[]
  volunteerTimeLogs   VolunteerTimeLog[]
  volunteerTimeConfig VolunteerTimeConfig?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrgMember {
  id     String  @id @default(cuid())
  userId String
  orgId  String
  role   OrgRole

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, orgId])
}

model Event {
  id             String    @id @default(cuid())
  orgId          String
  name           String
  slug           String
  shortCode      String    @unique
  date           DateTime?
  endDate        DateTime?
  location       String?
  description    String?   @db.Text
  waiverTemplate String?   @db.Text

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  waivers  Waiver[]
  checkIns CheckIn[]
  managers EventManager[]
  volunteerTimeLogs VolunteerTimeLog[]
  volunteerShifts   VolunteerShift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, slug])
}

model EventManager {
  id      String @id @default(cuid())
  eventId String
  userId  String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([eventId, userId])
}

// ──────────────────────────────────────────
// Waivers & Check-ins
// ──────────────────────────────────────────

model Waiver {
  id      String  @id @default(cuid())
  userId  String?
  eventId String

  // Participant info
  firstName             String
  lastName              String
  email                 String
  phone                 String?
  dateOfBirth           DateTime
  emergencyContactName  String
  emergencyContactPhone String

  // Family members (children under 18) stored as JSON array
  // Each element: { firstName, lastName, dateOfBirth }
  familyMembers Json?

  // Signature
  signatureData String @db.Text
  signatureType String
  signedAt      DateTime @default(now())
  ipAddress     String?
  userAgent     String?

  // Legal compliance
  electronicConsent     Boolean  @default(false)
  waiverContentSnapshot String?  @db.Text

  // Marketing opt-in
  mailchimpOptIn Boolean @default(false)

  // Volunteer tracking
  isVolunteer     Boolean   @default(false)
  volunteerHours  Decimal?
  verifiedHours   Decimal?
  hoursVerifiedAt DateTime?
  hoursVerifiedBy String?

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteerTimeLogs VolunteerTimeLog[]

  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@unique([email, eventId])
}

model CheckIn {
  id          String @id @default(cuid())
  userId      String
  eventId     String
  checkedInBy String

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checker User  @relation("CheckedInBy", fields: [checkedInBy], references: [id])

  checkedInAt DateTime @default(now())

  @@unique([userId, eventId])
}

// ──────────────────────────────────────────
// Volunteer Time Tracking
// ──────────────────────────────────────────

model VolunteerTimeLog {
  id               String        @id @default(cuid())
  organizationId   String
  eventId          String?
  waiverId         String?
  userId           String?
  volunteerEmail   String
  volunteerName    String
  familyMemberName String?
  clockIn          DateTime
  clockOut         DateTime?
  totalMinutes     Int?
  isManualEntry    Boolean       @default(false)
  status           TimeLogStatus @default(PENDING)
  reviewedBy       String?
  reviewedAt       DateTime?
  adminNote        String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  waiver       Waiver?      @relation(fields: [waiverId], references: [id], onDelete: SetNull)
  user         User?        @relation("VolunteerTimeLogs", fields: [userId], references: [id], onDelete: SetNull)
  reviewer     User?        @relation("ReviewedTimeLogs", fields: [reviewedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VolunteerTimeConfig {
  id              String  @id @default(cuid())
  organizationId  String  @unique
  autoExpireHours Int     @default(12)
  requireApproval Boolean @default(true)
  enabled         Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────
// Submissions (Support & Feature Requests)
// ──────────────────────────────────────────

model SupportTicket {
  id      String           @id @default(cuid())
  name    String
  email   String
  subject String
  message String           @db.Text
  status  SubmissionStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeatureRequest {
  id       String           @id @default(cuid())
  name     String
  email    String
  category String
  feature       String           @db.Text
  problem       String?          @db.Text
  willingToPay  String?
  monthlyBudget String?
  status        SubmissionStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────
// Volunteer Shift Scheduling
// ──────────────────────────────────────────

model VolunteerShift {
  id                   String   @id @default(cuid())
  eventId              String
  title                String
  description          String?  @db.Text
  startTime            DateTime
  endTime              DateTime
  slotDurationMinutes  Int
  defaultMaxVolunteers Int

  event Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slots VolunteerSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model VolunteerSlot {
  id            String   @id @default(cuid())
  shiftId       String
  startTime     DateTime
  endTime       DateTime
  maxVolunteers Int

  shift   VolunteerShift       @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  signups VolunteerSlotSignup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shiftId])
}

model VolunteerSlotSignup {
  id               String           @id @default(cuid())
  slotId           String
  volunteerEmail   String
  volunteerName    String
  familyMemberName String           @default("")
  status           SlotSignupStatus
  waitlistPosition Int?
  cancelledAt      DateTime?

  slot VolunteerSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slotId, volunteerEmail, familyMemberName])
  @@index([volunteerEmail])
  @@index([slotId, status])
}
